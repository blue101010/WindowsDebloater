; 0000000 = Off
; 0000001 = On (Default / CIS)
"EnableLUA"=dword:0000001

;;; 2.3.17.8 (L1) Ensure 'User Account Control: Switch to the secure desktop when prompting for elevation' is set to 'Enabled'
